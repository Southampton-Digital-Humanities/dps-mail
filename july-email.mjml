      <mj-column>

        <mj-image width="200px" src="https://github.com/Southampton-Digital-Humanities/dps-mail/blob/main/assets/dpslogo.png?raw=true"></mj-image>
        <mj-image width="200px" src="https://github.com/Southampton-Digital-Humanities/dps-mail/blob/main/assets/sotonlogo.png?raw=true"></mj-image>
